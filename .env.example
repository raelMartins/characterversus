# Copy to .env.local for local development.

# Required for building new character profiles and judging new fights.
# Get one at https://console.anthropic.com. Existing fights work without it.
ANTHROPIC_API_KEY=

# Leave empty locally to use the built-in embedded database (stored in ./.data).
# On Railway, set this to your Postgres service's connection string: ${{Postgres.DATABASE_URL}}
DATABASE_URL=

# How much pushback triggers an AI re-review of a verdict (optional).
REVIEW_MIN_DISPUTE_VOTES=25
REVIEW_MIN_DISAGREE_VOTES=30
